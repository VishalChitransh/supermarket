FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md requirements.txt ./
COPY src ./src
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir --no-deps .
COPY data ./data
RUN python -m superkart.train --data data/SuperKart.csv --output backend_files/superkart_model.joblib --no-tune
ENV PORT=7860
EXPOSE 7860
CMD ["python", "-m", "superkart.api"]
